<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="Economy\Finance\Budget\Domain\Model\FinanceBudgetCategory" table="finance_budget_category">
    <id name="id" type="string" column="id" primary="true" length="36"/>
    <field name="version" type="integer" version="true"/>
    <field name="budgetId" type="string" column="budget_id" length="36"/>
    <field name="category" type="string" column="category" length="30"/>
    <field name="kind" type="string" column="kind" length="10">
      <options>
        <option name="default">variable</option>
      </options>
    </field>
    <field name="amount" type="float" column="amount">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="position" type="integer" column="position"/>
    <field name="createdAt" type="datetime" column="created_at"/>
    <field name="updatedAt" type="datetime" column="updated_at"/>
    <field name="createdByUserId" type="string" column="created_by_user_id" length="36"/>
    <field name="updatedByUserId" type="string" column="updated_by_user_id" length="36"/>
    <indexes>
      <index name="idx_finance_budget_category_budget_id" columns="budget_id"/>
      <index name="idx_finance_budget_category_kind" columns="kind"/>
    </indexes>
    <unique-constraints>
      <unique-constraint name="uniq_finance_budget_category" columns="budget_id,category"/>
    </unique-constraints>
  </entity>
</doctrine-mapping>
