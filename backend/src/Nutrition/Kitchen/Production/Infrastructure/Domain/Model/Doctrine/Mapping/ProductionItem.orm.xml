<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
  <entity name="Nutrition\Kitchen\Production\Domain\Model\ProductionItem" table="production_item">
    <id name="id" type="string" column="id" primary="true" length="36"/>
    <field name="version" type="integer" version="true"/>
    <field name="productionId" type="string" column="production_id" length="36"/>
    <field name="position" type="integer" column="position"/>
    <field name="recipeId" type="string" column="recipe_id" length="36"/>
    <field name="status" type="string" column="status" length="16"/>
    <field name="servingsPlanned" type="float" column="servings_planned">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="servingsCooked" type="float" column="servings_cooked">
      <options>
        <option name="default">0</option>
      </options>
    </field>
    <field name="nameSnapshot" type="string" column="name_snapshot" length="255"/>
    <field name="emojiSnapshot" type="string" column="emoji_snapshot" length="16"/>
    <field name="code" type="string" column="code" length="16" nullable="true"/>
    <field name="label" type="string" column="label" length="120" options="{&quot;default&quot;: &quot;&quot;}"/>
    <field name="customized" type="boolean" column="customized" options="{&quot;default&quot;: false}"/>
    <field name="checkedArticleIds" type="json" column="checked_articles"/>
    <field name="checkedStepPositions" type="json" column="checked_steps"/>
    <field name="createdAt" type="datetime" column="created_at"/>
    <field name="updatedAt" type="datetime" column="updated_at"/>
    <field name="createdByUserId" type="string" column="created_by_user_id" length="36"/>
    <field name="updatedByUserId" type="string" column="updated_by_user_id" length="36"/>
    <indexes>
      <index name="idx_production_item_production_id" columns="production_id"/>
      <index name="idx_production_item_recipe_id" columns="recipe_id"/>
    </indexes>
    <unique-constraints>
      <unique-constraint name="uniq_production_item_code" columns="code"/>
    </unique-constraints>
  </entity>
</doctrine-mapping>
