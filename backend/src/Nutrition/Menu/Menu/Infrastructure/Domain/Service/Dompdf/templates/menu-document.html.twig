{% import _self as ui %}

{% macro qty(value, locale) %}
{%- apply spaceless -%}
    {{- value|localized_number(locale) -}}
{%- endapply -%}
{% endmacro %}

{% macro unit(key, value, locale) %}
{%- apply spaceless -%}
    {{- ('unit.' ~ key)|trans({'%count%': value}, 'menu_document', locale) -}}
{%- endapply -%}
{% endmacro %}

{% macro glyph(emoji, size) %}
{%- apply spaceless -%}
    {%- set src = emoji|emoji_src -%}
    {%- if src -%}
        <img class="glyph" style="width: {{ size }}pt; height: {{ size }}pt;" src="{{ src }}">
    {%- else -%}
        <span class="glyph-dot" style="width: {{ size }}pt; height: {{ size }}pt;"></span>
    {%- endif -%}
{%- endapply -%}
{% endmacro %}

{% macro ingredients(rows, locale, depth) %}
    {% for row in rows %}
        <table class="ing">
            <tr>
                <td class="ing-mark" style="padding-left: {{ depth * 10 }}pt;">{{ _self.glyph(row.emoji, 8.5) }}</td>
                <td class="ing-name">{{ row.name }}</td>
                <td class="ing-qty">
                    {{- _self.qty(row.quantity, locale) }}
                    {{ _self.unit(row.kind == 'recipe' ? 'serving' : row.unit, row.quantity, locale) -}}
                </td>
                <td class="ing-kcal">{{ row.macros.calories|localized_number(locale, 0) }}</td>
            </tr>
        </table>
        {% if row.children is not empty %}
            {{ _self.ingredients(row.children, locale, depth + 1) }}
        {% endif %}
    {% endfor %}
{% endmacro %}

{% macro macroBar(label, grams, reference, locale) %}
    <table class="macro">
        <tr>
            <td class="macro-label">{{ label }}</td>
            <td class="macro-track">
                <div class="macro-fill" style="width: {{ reference > 0 ? (grams / reference * 100)|round : 0 }}%;"></div>
            </td>
            <td class="macro-value">{{ grams|localized_number(locale, 0) }} g</td>
        </tr>
    </table>
{% endmacro %}

<html>
<head>
    <meta charset="utf-8">
    <title>{{ menu.name }}</title>
    <style>
        @page { margin: 15mm 14mm 18mm; }

        /* dompdf no pinta el fondo del body sobre los márgenes de @page:
           el lienzo se cubre con una capa fija del tamaño del A4. */
        .page-bg {
            position: fixed;
            top: -15mm;
            left: -14mm;
            width: 210mm;
            height: 297mm;
            z-index: -1;
            background-color: {{ palette.page }};
        }

        body {
            margin: 0;
            background-color: {{ palette.page }};
            font-family: 'brand-body';
            font-size: 9.5pt;
            line-height: 1.45;
            color: {{ palette.text }};
        }

        h1, h2, .eyebrow, .day-pill, .summary-kcal {
            font-family: 'brand-display';
        }

        .brand-rule {
            height: 3pt;
            background-color: {{ palette.brand }};
            margin-bottom: 12pt;
        }

        .eyebrow {
            font-size: 7.5pt;
            font-weight: 700;
            letter-spacing: 1.6pt;
            text-transform: uppercase;
            color: {{ palette.brand }};
            margin-bottom: 3pt;
        }

        h1 {
            font-size: 25pt;
            font-weight: 800;
            line-height: 1.1;
            color: {{ palette.text }};
            margin: 0 0 5pt;
        }

        .meta { font-size: 8.5pt; color: {{ palette.textMuted }}; }

        .note {
            margin-top: 11pt;
            padding: 8pt 10pt;
            background-color: {{ palette.surfaceInset }};
            border-left: 2.5pt solid {{ palette.brand }};
            border-radius: 3pt;
            font-size: 9pt;
            color: {{ palette.textBody }};
        }

        .summary {
            width: 100%;
            border-collapse: separate;
            margin: 16pt 0 4pt;
            background-color: {{ palette.surfaceInset }};
            border: 0.8pt solid {{ palette.border }};
            border-radius: 12pt;
        }
        .summary td { padding: 13pt 14pt; vertical-align: middle; }
        .summary-main { width: 40%; }
        .summary-label {
            font-size: 7.5pt;
            letter-spacing: 1.2pt;
            text-transform: uppercase;
            color: {{ palette.textMeta }};
            margin-bottom: 2pt;
        }
        .summary-kcal {
            font-size: 26pt;
            font-weight: 800;
            line-height: 1;
            color: {{ palette.brand }};
        }
        .summary-kcal span { font-size: 11pt; font-weight: 700; }
        .summary-sub { margin-top: 4pt; font-size: 8.5pt; color: {{ palette.textMuted }}; }

        .macro { width: 100%; border-collapse: collapse; }
        .macro td { padding: 2.5pt 0; }
        .macro-label { width: 52pt; font-size: 8.5pt; color: {{ palette.textMuted }}; }
        .macro-track {
            background-color: {{ palette.barTrack }};
            border-radius: 3pt;
            height: 7pt;
        }
        .macro-fill {
            height: 7pt;
            background-color: {{ palette.barFill }};
            border-radius: 3pt;
        }
        .macro-value {
            width: 40pt;
            text-align: right;
            font-size: 8.5pt;
            font-weight: 700;
            color: {{ palette.text }};
        }

        .day { margin-top: 20pt; }
        .day-head { width: 100%; border-collapse: collapse; margin-bottom: 7pt; }
        .day-head td { vertical-align: bottom; border-bottom: 1.2pt solid {{ palette.border }}; padding-bottom: 4pt; }
        .day-pill {
            font-size: 12.5pt;
            font-weight: 800;
            letter-spacing: 0.4pt;
            text-transform: uppercase;
            color: {{ palette.text }};
        }
        .day-stats { text-align: right; font-size: 8pt; color: {{ palette.textMuted }}; }
        .day-stats b { color: {{ palette.text }}; }

        .meal { margin-top: 10pt; }
        .meal-head {
            font-size: 7.5pt;
            font-weight: 700;
            letter-spacing: 1.4pt;
            text-transform: uppercase;
            color: {{ palette.textMeta }};
            border-bottom: 0.6pt solid {{ palette.borderHairline }};
            padding-bottom: 3pt;
            margin-bottom: 5pt;
        }
        .meal-head .meal-kcal { float: right; letter-spacing: 0; color: {{ palette.textMuted }}; }

        .item-block { margin-bottom: 6pt; }

        .item { width: 100%; border-collapse: collapse; page-break-inside: avoid; }
        .item td { vertical-align: top; padding: 1pt 0; }
        .c-emoji { width: 20pt; }
        .c-name { font-size: 10pt; }
        .c-name .name { font-weight: 700; }
        .c-name .qty {
            display: inline-block;
            margin-left: 5pt;
            padding: 0.5pt 5pt;
            background-color: {{ palette.surfaceInset }};
            border-radius: 6pt;
            font-size: 8pt;
            color: {{ palette.textBody }};
        }
        .c-name .tag {
            display: inline-block;
            margin-left: 4pt;
            padding: 0.5pt 5pt;
            background-color: {{ palette.brandSoft }};
            border: 0.5pt solid {{ palette.brandSoftBorder }};
            border-radius: 6pt;
            font-size: 7pt;
            font-weight: 700;
            letter-spacing: 0.4pt;
            text-transform: uppercase;
            color: {{ palette.brandSoftText }};
        }
        .c-kcal {
            width: 58pt;
            text-align: right;
            font-size: 9pt;
            font-weight: 700;
            color: {{ palette.brand }};
        }

        .ingredients {
            margin: 3pt 0 0 20pt;
            padding: 5pt 0 3pt 9pt;
            border-left: 1.5pt solid {{ palette.border }};
        }
        .ing-title {
            font-size: 7pt;
            font-weight: 700;
            letter-spacing: 1.1pt;
            text-transform: uppercase;
            color: {{ palette.textMeta }};
            margin-bottom: 3pt;
        }
        .ing-title .kcal-head { float: right; color: {{ palette.textMeta }}; }
        .ing { width: 100%; border-collapse: collapse; }
        .ing td { padding: 0.8pt 0; font-size: 8.5pt; color: {{ palette.textBody }}; }
        .ing-mark { width: 16pt; }
        .ing-qty { width: 78pt; text-align: right; color: {{ palette.textMuted }}; }
        .ing-kcal { width: 34pt; text-align: right; color: {{ palette.textMeta }}; }

        .glyph { vertical-align: middle; }
        .glyph-dot {
            display: inline-block;
            background-color: {{ palette.surfaceInset }};
            border-radius: 50%;
        }

        .empty {
            margin-top: 24pt;
            padding: 16pt;
            background-color: {{ palette.surfaceInset }};
            border-radius: 8pt;
            text-align: center;
            font-size: 9.5pt;
            color: {{ palette.textMuted }};
        }

        .footer {
            position: fixed;
            bottom: -11mm;
            left: 0;
            right: 0;
            font-size: 7.5pt;
            color: {{ palette.textMeta }};
            border-top: 0.6pt solid {{ palette.borderHairline }};
            padding-top: 4pt;
        }
        .footer .page:after { content: counter(page); }
        .footer .right { float: right; }
    </style>
</head>
<body>

<div class="page-bg"></div>

<div class="footer">
    {{ menu.name }}
    <span class="right">{{ 'document.footer'|trans({}, 'menu_document', locale) }} · <span class="page"></span></span>
</div>

<div class="brand-rule"></div>

<div class="eyebrow">
    {{ ('document.eyebrow.' ~ (menu.type == 'week' ? 'week' : 'single'))|trans({}, 'menu_document', locale) }}
</div>
<h1>{{ menu.name }}</h1>
<div class="meta">
    {%- if menu.type == 'week' -%}
        {{ 'document.meta.days'|trans({'%count%': menu.plannedDayCount}, 'menu_document', locale) }} ·
    {%- endif -%}
    {{ 'document.meta.items'|trans({'%count%': menu.itemCount}, 'menu_document', locale) }} ·
    {{ 'document.meta.generated'|trans({'%date%': menu.generatedAt|date('d/m/Y')}, 'menu_document', locale) }}
</div>

{% if menu.note is not empty %}
    <div class="note">{{ menu.note }}</div>
{% endif %}

{% set reference = max(menu.total.protein, menu.total.fat, menu.total.carbs) %}

<table class="summary">
    <tr>
        <td class="summary-main">
            <div class="summary-label">{{ 'document.summary.total'|trans({}, 'menu_document', locale) }}</div>
            <div class="summary-kcal">{{ menu.total.calories|localized_number(locale, 0) }} <span>kcal</span></div>
            <div class="summary-sub">
                {{ 'document.summary.perDay'|trans({}, 'menu_document', locale) }} ·
                {{ menu.perDay.calories|localized_number(locale, 0) }} kcal
            </div>
        </td>
        <td>
            {{ ui.macroBar('document.summary.protein'|trans({}, 'menu_document', locale), menu.total.protein, reference, locale) }}
            {{ ui.macroBar('document.summary.carbs'|trans({}, 'menu_document', locale), menu.total.carbs, reference, locale) }}
            {{ ui.macroBar('document.summary.fat'|trans({}, 'menu_document', locale), menu.total.fat, reference, locale) }}
        </td>
    </tr>
</table>

{% if menu.days is empty %}
    <div class="empty">{{ 'document.empty'|trans({}, 'menu_document', locale) }}</div>
{% endif %}

{% for day in menu.days %}
    <div class="day">
        <table class="day-head">
            <tr>
                <td>
                    <span class="day-pill">
                        {{ ('day.' ~ (day.dayKey ?? 'single'))|trans({}, 'menu_document', locale) }}
                    </span>
                </td>
                <td class="day-stats">
                    <b>{{ day.totals.calories|localized_number(locale, 0) }} kcal</b> ·
                    {{ 'document.short.protein'|trans({}, 'menu_document', locale) }} {{ day.totals.protein|localized_number(locale, 0) }} g ·
                    {{ 'document.short.carbs'|trans({}, 'menu_document', locale) }} {{ day.totals.carbs|localized_number(locale, 0) }} g ·
                    {{ 'document.short.fat'|trans({}, 'menu_document', locale) }} {{ day.totals.fat|localized_number(locale, 0) }} g
                </td>
            </tr>
        </table>

        {% for meal in day.meals %}
            <div class="meal">
                <div class="meal-head">
                    {{ ('meal.' ~ meal.key)|trans({}, 'menu_document', locale) }}
                    <span class="meal-kcal">{{ meal.totals.calories|localized_number(locale, 0) }} kcal</span>
                </div>

                {% for item in meal.items %}
                    <div class="item-block">
                        <table class="item">
                            <tr>
                                <td class="c-emoji">{{ ui.glyph(item.emoji, 13) }}</td>
                                <td class="c-name">
                                    <span class="name">{{ item.name }}</span>
                                    <span class="qty">{{ ui.qty(item.quantity, locale) }} {{ ui.unit(item.unit, item.quantity, locale) }}</span>
                                    {%- if item.customized %}
                                        <span class="tag">{{ 'document.customized'|trans({}, 'menu_document', locale) }}</span>
                                    {%- endif %}
                                </td>
                                <td class="c-kcal">{{ item.macros.calories|localized_number(locale, 0) }} kcal</td>
                            </tr>
                        </table>

                        {% if item.tree is not empty %}
                            <div class="ingredients">
                                <div class="ing-title">
                                    {{ 'document.ingredients'|trans({}, 'menu_document', locale) }}
                                    {%- if item.servings and not item.customized %} ·
                                        {{ 'document.recipeFor'|trans({'%count%': item.servings}, 'menu_document', locale) }}
                                    {%- endif %}
                                    <span class="kcal-head">kcal</span>
                                </div>
                                {{ ui.ingredients(item.tree, locale, 0) }}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% endfor %}

</body>
</html>
