{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend (ng serve)",
      "type": "shell",
      "command": "bash .devcontainer/frontend.sh",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "golifecraft"
      },
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "^__never_match__$"
        },
        "background": {
          "beginsPattern": "Waiting for frontend dependencies|Building",
          "endsPattern": "Application bundle generation (complete|failed)"
        }
      }
    }
  ]
}
